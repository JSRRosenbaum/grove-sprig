+fn writeOscField(writer: *std.Io.Writer, value: []const u8, parameter: bool) std.Io.Writer.Error!void {
+    for (value) |byte| {
+        if (byte < 0x20 or byte == 0x7f or (parameter and (byte == ';' or byte == ':'))) {
+            try writer.print("%{x:0>2}", .{byte});
+        } else {
+            try writer.writeByte(byte);
+        }
+    }
+}
