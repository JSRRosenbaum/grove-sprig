+/// Clear primary history and rows above the cursor's visible wrapped line.
+/// This does not pass bytes through the VT stream or write to the child.
+pub fn clear_primary(terminal_: Terminal) callconv(lib.calling_conv) bool {
+    const wrapper = terminal_ orelse return false;
+    const t = wrapper.terminal;
+    if (t.screens.active_key == .alternate) return false;
+    const screen = t.screens.active;
+    var first = screen.cursor.y;
+    var pin = screen.cursor.page_pin.*;
+    while (first > 0 and pin.rowAndCell().row.wrap_continuation) {
+        pin = pin.up(1) orelse break;
+        first -= 1;
+    }
+    var last = screen.cursor.y;
+    pin = screen.cursor.page_pin.*;
+    while (last + 1 < t.rows and pin.rowAndCell().row.wrap) {
+        pin = pin.down(1) orelse break;
+        last += 1;
+    }
+    if (last + 1 < t.rows) {
+        screen.clearRows(.{ .active = .{ .y = last + 1 } }, null, false);
+    }
+    screen.clearSelection();
+    t.eraseDisplay(.scrollback, false);
+    if (first > 0) screen.eraseActive(first - 1);
+    screen.scroll(.active);
+    t.flags.dirty.clear = true;
+    return true;
+}
+
+/// DECSCUSR representation of the current cursor appearance.
+pub fn cursor_shape(terminal_: Terminal) callconv(lib.calling_conv) u8 {
+    const wrapper = terminal_ orelse return 0;
+    const t = wrapper.terminal;
+    const base: u8 = switch (t.screens.active.cursor.cursor_style) {
+        .block, .block_hollow => 1,
+        .underline => 3,
+        .bar => 5,
+    };
+    return base + @as(u8, if (t.modes.get(.cursor_blinking)) 0 else 1);
+}
+
+/// Copy the 256-bit OSC palette override mask to the caller.
+pub fn palette_override_mask(terminal_: Terminal, out_: ?[*]u8) callconv(lib.calling_conv) bool {
+    const wrapper = terminal_ orelse return false;
+    const out = out_ orelse return false;
+    for (0..32) |byte| {
+        var bits: u8 = 0;
+        for (0..8) |bit| {
+            if (wrapper.terminal.colors.palette.mask.isSet(byte * 8 + bit)) {
+                bits |= @as(u8, 1) << @intCast(bit);
+            }
+        }
+        out[byte] = bits;
+    }
+    return true;
+}
