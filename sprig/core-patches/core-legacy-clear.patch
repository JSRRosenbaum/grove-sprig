+#[test]
+fn repaint_preserves_wrapping_and_cursor_without_requesting_viewer_input() {
+    let mut source = Terminal::new(10, 5, 1 << 20);
+    source.write(b"abcdefghijklm\x1b[?7l\x1b[6 q\x1b[?2048h");
+    let mut viewer = Terminal::new(10, 5, 1 << 20);
+    viewer.write(b"\x1b[?2048h");
+    viewer.take_responses();
+    viewer.write(&source.paint_in_place());
+    assert_eq!(viewer.plain_text(), source.plain_text());
+    assert!(!viewer.dec_mode(7));
+    assert!(viewer.dec_mode(2048));
+    assert_eq!(unsafe { ffi::ghostty_terminal_cursor_shape(viewer.raw) }, 6);
+    assert!(viewer.take_responses().is_empty(), "repaint must not generate child input");
+}
+
+#[test]
+fn clear_repaint_does_not_scroll_old_prompt_into_viewer_history() {
+    let mut source = Terminal::new(20, 4, 1 << 20);
+    source.write(b"kept prompt");
+    let mut viewer = Terminal::new(20, 4, 1 << 20);
+    viewer.write(b"old one\r\nold two\r\nold three\r\n\x1b]133;A\x07old prompt");
+    viewer.write(b"\x18\x1b[?1049l\x1b[?1047l\x1b[?47l\x1b[3J");
+    viewer.write(&source.paint_in_place());
+    let text = viewer.plain_text();
+    assert!(text.contains("kept prompt"), "{text:?}");
+    assert!(!text.contains("old"), "{text:?}");
+}
+
+#[test]
+fn clear_repaint_preserves_closed_hyperlinks_on_retained_line() {
+    let mut source = Terminal::new(40, 4, 1 << 20);
+    source.write(b"old\r\n\x1b]8;;https://example.com/path\x1b\\click here\x1b]8;;\x1b\\ prompt");
+    assert!(source.clear_primary());
+    let mut viewer = Terminal::new(40, 4, 1 << 20);
+    viewer.write(b"old viewer text\r\n\x1b]133;A\x07old prompt");
+    viewer.write(b"\x18\x1b[?1049l\x1b[?1047l\x1b[?47l\x1b[3J");
+    viewer.write(&source.paint_in_place());
+    let repaint = viewer.paint(0);
+    assert!(repaint.windows(b"https://example.com/path".len()).any(|w| w == b"https://example.com/path"));
+    assert!(viewer.plain_text().contains("click here prompt"));
+    assert!(!viewer.plain_text().contains("old viewer"));
+}
